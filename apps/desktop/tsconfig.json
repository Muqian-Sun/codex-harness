{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "src/main/**/*.ts",
    "src/electron/**/*.ts",
    "src/preload/**/*.cts",
    "src/shared/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/test-fixtures.ts"],
  "references": [{ "path": "../../packages/protocol" }]
}
